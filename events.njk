---
layout: base.njk
pageTitle: "Antalya Events & Festivals | Concerts, Theatre & What's On"
pageDescription: "Find Antalya concerts, theatre, festivals and sports events with verified dates, venues and official ticket links."
pageUrl: "/events/"
ogImage: "/images/editorial/aspendos-entrance.jpg"
permalink: "/events/index.html"
eleventyExcludeFromCollections: true
---
{% from 'ui.njk' import icon, pageHero %}
{{ pageHero(editorialPhotos | photoById('aspendos-entrance'), 'Events', 'What’s on in Antalya', 'Concerts, theatre & festivals', [{label: 'Events'}]) }}

<section class="section-tight" aria-labelledby="cat-title" style="padding-top:0">
  <div class="container">
    <h2 id="cat-title" class="sr-only">Browse by category</h2>
    <nav class="quick-nav" aria-label="Event categories">
      {% for cat in collections.eventCategories | take(6) %}<a href="/events/category/{{ cat.name | slugify }}/">{{ icon({'Concerts': 'music', 'Theatre': 'ticket', 'Comedy': 'sparkle', 'Festivals': 'star', 'Family': 'family', 'Sports': 'golf', 'Cultural': 'landmark', 'Conferences': 'users', 'Nightlife': 'music', 'Ballet & music': 'music'}[cat.name] or 'calendar') }}<span>{{ cat.name }}</span></a>{% endfor %}
    </nav>
  </div>
</section>

<section class="directory" aria-labelledby="ev-title">
  <div class="container">
    <div class="section-head"><div><p class="eyebrow">Plan around something memorable</p><h2 id="ev-title">Upcoming events</h2></div></div>
    {% set eventItems = collections.events %}{% set showCategory = true %}
    {% include 'event-grid.njk' %}
    <p class="source-note" style="margin-top:28px">Dates are checked against the organiser or ticket page and shown in Antalya time. Schedules change — confirm with the organiser before you travel. Official calendars: <a href="https://www.antalya.bel.tr/tr/etkinlikler" target="_blank" rel="noopener noreferrer">Municipality</a> · <a href="https://www.operabale.gov.tr/" target="_blank" rel="noopener noreferrer">State Opera &amp; Ballet</a> · <a href="https://antalyaff.com/tr" target="_blank" rel="noopener noreferrer">Golden Orange Film Festival</a>.</p>
  </div>
</section>
