---
layout: base.njk
pageTitle: Admin dashboard
pageDescription: Content health for Travel Antalya editors.
permalink: /admin/dashboard/index.html
noindex: true
eleventyExcludeFromCollections: true
bodyClass: admin-page
---
{% from 'ui.njk' import icon %}
{% set groups = [
  {key: 'hotels', label: 'Hotels', items: collections.hotels, path: '/hotels/', icon: 'bed'},
  {key: 'restaurants', label: 'Restaurants', items: collections.restaurants, path: '/restaurants/', icon: 'food'},
  {key: 'golf', label: 'Golf', items: collections.golf, path: '/golf/', icon: 'golf'},
  {key: 'events', label: 'Events', items: collections.events, path: '/events/', icon: 'calendar'},
  {key: 'things-to-do', label: 'Things to do', items: collections.thingsToDo, path: '/things-to-do/', icon: 'sun'},
  {key: 'blog', label: 'Blog posts', items: collections.blog, path: '/blog/', icon: 'book'}
] %}
<section class="page-head section-sand">
  <div class="container">
    <p class="eyebrow">Editor tools</p>
    <h1>Content dashboard</h1>
    <p class="lead">Everything that needs attention, in one place. Built {{ buildDate }}.</p>
    <div class="button-row"><a class="btn btn-orange" href="/admin/">Open the editor</a><a class="btn btn-outline" href="/admin/photos/">Photo library</a></div>
  </div>
</section>
<section class="section-tight">
  <div class="container">
    <div class="kpis">
      {% for g in groups %}
      {% set report = g.items | contentHealth(editorialPhotos) %}
      <a class="kpi" href="#{{ g.key }}">{{ icon(g.icon) }}<strong>{{ g.items.length }}</strong><span>{{ g.label }}</span><small>{{ report.withPhoto }} with own photos · {{ report.thin.length }} thin</small></a>
      {% endfor %}
    </div>
  </div>
</section>
{% for g in groups %}
{% set report = g.items | contentHealth(editorialPhotos) %}
<section class="section-tight" id="{{ g.key }}">
  <div class="container">
    <div class="section-head"><div><p class="eyebrow">{{ g.items.length }} entries · {{ report.withPhoto }} with own photos</p><h2>{{ g.label }}</h2></div><a class="btn btn-sm" href="/admin/#/collections/{{ g.key }}/new">+ New</a></div>
    <div class="admin-table-wrap"><table class="admin-table">
      <thead><tr><th>Entry</th><th>Photo</th><th>Words</th><th>Checked</th><th>Issues</th><th></th></tr></thead>
      <tbody>
      {% for row in report.rows %}
      <tr class="{% if row.issues.length %}has-issues{% endif %}">
        <td><a href="{{ row.url }}" target="_blank" rel="noopener">{{ row.title }}</a><small>{{ row.area }}</small></td>
        <td>{% if row.thumb %}<img src="{{ row.thumb }}" alt="" width="96" height="64" loading="lazy">{% endif %}<small>{{ row.photoKind }}</small></td>
        <td>{{ row.words }}</td>
        <td>{{ row.checked }}</td>
        <td>{% for i in row.issues %}<span class="issue">{{ i }}</span>{% endfor %}</td>
        <td><a class="text-link" href="/admin/#/collections/{{ g.key }}/entries/{{ row.file }}">Edit</a></td>
      </tr>
      {% endfor %}
      </tbody>
    </table></div>
  </div>
</section>
{% endfor %}
