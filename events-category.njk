---
pagination:
  data: collections.eventCategories
  size: 1
  alias: cat
permalink: "/events/category/{{ cat.name | slugify }}/index.html"
layout: base.njk
eleventyExcludeFromCollections: true
---
{% from 'ui.njk' import icon, pageHero %}
{{ pageHero(editorialPhotos | photoById({'Concerts': 'side-theatre', 'Theatre': 'aspendos-theatre', 'Festivals': 'kaleici-marina', 'Sports': 'konyaalti-coast', 'Family': 'upper-duden-park', 'Cultural': 'aspendos-entrance'}[cat.name] or 'perge-theatre'), 'Antalya events', cat.name + ' in Antalya', cat.events.length + ' listings', [{label: 'Events', href: '/events/'}, {label: cat.name}]) }}
<section class="directory" aria-label="{{ cat.name }} events">
  <div class="container">
    {% set eventItems = cat.events %}{% set showCategory = false %}
    {% include 'event-grid.njk' %}
    <p style="margin-top:28px"><a class="btn btn-outline" href="/events/">All event categories</a></p>
  </div>
</section>
