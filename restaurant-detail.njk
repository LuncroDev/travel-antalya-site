---
pagination:
  data: collections.restaurants
  size: 1
  alias: r
permalink: "/restaurants/{{ r.data.slug or (r.data.title | slugify) }}/index.html"
layout: base.njk
eleventyExcludeFromCollections: true
---
<section class="listing-hero detail-heading"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/restaurants/">Restaurants</a> / {{ r.data.title }}</nav><span class="eyebrow">{{ r.data.neighborhood }} · {{ r.data.category }}</span><h1>{{ r.data.title }}</h1><p class="lead">{{ r.data.tagline or r.data.excerpt }}</p></div></section>
<div class="container"><div class="guide-columns"><article><h2>About the restaurant</h2>{{ r.templateContent | safe }}{% if r.data.status_note %}<div class="notice"><strong>Before you go</strong><p>{{ r.data.status_note }}</p></div>{% endif %}<h2>Planning your table</h2><p>{{ r.data.booking_note or 'Confirm the current opening hours, menu, dietary options and reservation conditions directly with the restaurant.' }}</p><p>This profile is an editorial introduction, not a first-hand review or Michelin distinction.</p>{% set galleryItem = r.data %}{% include 'editorial-gallery.njk' %}{% set relatedItem = r.data %}{% include 'related-guide.njk' %}</article><aside class="planning-card"><span class="eyebrow">Go to the source</span><h2>Plan your visit</h2><p>{{ r.data.neighborhood }}</p>{% if r.data.official_url %}<a class="btn btn-orange" href="{{ r.data.official_url }}" target="_blank" rel="noopener">Official restaurant website ↗</a>{% else %}<a class="btn btn-orange" href="{{ r.data.source_url }}" target="_blank" rel="noopener">Identity and address source ↗</a>{% endif %}<p class="source-note">Source reviewed <time datetime="{{ r.data.last_checked }}">{{ r.data.last_checked }}</time>. <a href="{{ r.data.source_url or r.data.booking_url }}">{{ r.data.source_label or 'Restaurant information' }}</a>. Opening and reservation availability are not live-verified.</p>{% if r.data.michelin_note %}<p class="source-note">{{ r.data.michelin_note }}</p>{% endif %}<a href="/restaurants/">Compare restaurants →</a><a href="/hotels/?area={{ r.data | hotelAreaFor | encodeUri }}">Find a place to stay →</a></aside></div></div>
