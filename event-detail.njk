---
pagination:
  data: collections.events
  size: 1
  alias: event
permalink: "/events/{{ event.data.slug or (event.data.title | slugify) }}/index.html"
layout: base.njk
eleventyExcludeFromCollections: true

---

<div class="container detail-title-block"><div class="breadcrumb"><a href="/">Home</a> › <a href="/events/">Events</a> › {{ event.data.title }}</div><span class="badge">{{ event.data.category }}</span><h1>{{ event.data.title }}</h1><p class="lead">{{ event.data.tagline }}</p></div>
<div class="container" data-event-directory>
  <article data-event data-title="{{ event.data.title | escape }}" data-venue="{{ event.data.venue | escape }}" data-category="{{ event.data.category | escape }}" data-start="{{ event.data.start_date | eventDate }}" data-end="{{ event.data.end_date | eventDate }}" data-verified="{{ event.data.date_verified }}">
    <p class="badge" data-event-status>{{ event.data | eventStatus | eventStatusLabel }}</p>
    <div class="detail-columns"><div><h2>About this event</h2>{{ event.templateContent | safe }}{% set galleryItem = event.data %}{% include 'editorial-gallery.njk' %}{% set relatedItem = event.data %}{% include 'related-guide.njk' %}<p><a href="/events/">← Back to the event calendar</a></p></div>
    <aside class="detail-side"><h2>Plan your visit</h2><p><strong>{{ event.data | eventDateLabel }}</strong></p>{% if event.data.time_display and event.data.date_verified %}<p>{{ event.data.time_display }} (Antalya local time)</p>{% endif %}<p>{{ event.data.venue }}</p>{% if event.data.admission_note %}<p class="event-admission-note"><strong>Entry:</strong> {{ event.data.admission_note }}</p>{% endif %}<p>{{ event.data.verification_note }}</p><p>Source review: <time datetime="{{ event.data.last_checked | eventDate }}">{{ event.data.last_checked | eventDate }}</time></p><a href="{{ event.data.source_url | escape }}" target="_blank" rel="noopener noreferrer" class="btn btn-orange">{{ event.data.source_name }} ↗</a><p><small>Schedules and entry conditions can change. Verify directly before buying tickets or travelling. Past editions do not confirm next year's dates.</small></p></aside></div>
  </article>
</div>
<script src="/js/events.js" defer></script>
