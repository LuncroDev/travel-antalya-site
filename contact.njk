<p>We read every message. Use this form for corrections, suggestions for places and events, and partnership questions. We aim to reply within a few working days.</p>
<form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/contact-thanks/" style="display:grid; gap:16px; margin-top:24px;">
  <input type="hidden" name="form-name" value="contact">
  <p style="display:none;"><label>Do not fill this out: <input name="bot-field"></label></p>
  <label>Your name<br><input type="text" name="name" required style="width:100%; padding:12px; border:1px solid #cfd8e0; border-radius:8px; font:inherit;"></label>
  <label>Your email<br><input type="email" name="email" required style="width:100%; padding:12px; border:1px solid #cfd8e0; border-radius:8px; font:inherit;"></label>
  <label>Topic<br>
    <select name="topic" style="width:100%; padding:12px; border:1px solid #cfd8e0; border-radius:8px; font:inherit;">
      <option>Correction</option><option>Suggest a place or event</option><option>Partnership</option><option>Other</option>
    </select></label>
  <label>Message<br><textarea name="message" rows="6" required style="width:100%; padding:12px; border:1px solid #cfd8e0; border-radius:8px; font:inherit;"></textarea></label>
  <button type="submit" class="btn" style="justify-self:start;">Send message</button>
</form>
<p style="margin-top:28px;">Based in Antalya, Turkey.</p>

