{# Shared detail layout for hotels, restaurants and golf clubs.
   Expects: v (item.data), body (rendered content), kind, listHref, listLabel, kindIcon, officialLabel #}
{% from 'ui.njk' import icon, pic, credit, card %}
{% set gallery = v | photoGalleryFor(editorialPhotos) %}
<section class="detail-hero">
  <div class="container" style="padding:0">
    <div class="detail-gallery{% if gallery.length < 3 %} single{% endif %}">
      {% for ph in gallery | take(3) %}
      {% if loop.first or gallery.length >= 3 %}
      <figure>
        {{ pic(ph.src, ph.alt, ('(max-width: 860px) 100vw, 66vw' if loop.first else '33vw'), loop.first, ph.width, ph.height) }}
        <figcaption>{% if ph.contextual %}Area photo · {% endif %}{{ ph.caption }}</figcaption>
        {{ credit(ph) }}
      </figure>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<div class="container detail-head">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> <span aria-hidden="true">/</span> <a href="{{ listHref }}">{{ listLabel }}</a> <span aria-hidden="true">/</span> <span aria-current="page">{{ v.title }}</span></nav>
  <p class="eyebrow">{{ v.neighborhood }}{% if v.category %} · {{ v.category }}{% endif %}</p>
  <h1>{{ v.title }}</h1>
  <ul class="facts">
    <li>{{ icon('pin') }}{{ v.neighborhood }}</li>
    {% if v.category %}<li>{{ icon(kindIcon) }}{{ v.category }}</li>{% endif %}
    {% if v.official_url %}<li>{{ icon('globe') }}<a href="{{ v.official_url | escape }}" target="_blank" rel="noopener">{{ officialLabel }}</a></li>{% endif %}
  </ul>
</div>

<div class="container detail-layout">
  <article>
    <div class="prose">{{ body | safe }}</div>
    {% if v.status_note %}<div class="notice"><strong>Before you go</strong><p>{{ v.status_note }}</p></div>{% endif %}

    <div class="good-to-know">
      {% if kind == 'hotel' %}
      <details><summary>Before you book</summary><ul class="highlight-list"><li>The full price for your dates, party size and room type, including taxes and extras.</li><li>Cancellation and payment terms, meal plan and restaurant reservations.</li><li>Seasonal opening dates, beach and pool access, building work and transfers.</li><li>Age policy, step-free access or other specific needs — directly with the hotel.</li></ul></details>
      {% elif kind == 'golf' %}
      <details><summary>Before booking a round</summary><ul class="highlight-list"><li>Visitor access, tee times and any handicap certificate requirement.</li><li>The full green fee, cancellation terms, equipment hire and transfers.</li><li>Which course is in play, maintenance dates and seasonal conditions.</li></ul>{% if v.booking_note %}<p>{{ v.booking_note }}</p>{% endif %}</details>
      {% else %}
      <details><summary>Planning your table</summary><p>{{ v.booking_note or 'Confirm current opening hours, menu, dietary options and reservation conditions directly with the restaurant.' }}</p>{% if v.michelin_note %}<p>{{ v.michelin_note }}</p>{% endif %}</details>
      {% endif %}
      {% for district in destinations %}{% if district.slug == (v | districtFor) %}
      <details><summary>About the area: {{ district.name }}</summary><p>{{ district.description }}</p><p>{{ district.tip }}</p><p><a class="text-link" href="/destinations/{{ district.slug }}/">Explore {{ district.name }} {{ icon('arrow-right') }}</a></p></details>
      {% endif %}{% endfor %}
      <details><summary>About this profile</summary><p>An editorial introduction based on the official source, not a personal inspection, review score or live availability. Source reviewed <time datetime="{{ v.last_checked }}">{{ v.last_checked }}</time>{% if v.source_url %} · <a href="{{ v.source_url | escape }}" rel="noopener">{{ v.source_label or 'Source' }}</a>{% endif %}.</p></details>
    </div>

    {% set relatedItem = v %}{% include 'related-guide.njk' %}
    {% set galleryItem = v %}{% include 'editorial-gallery.njk' %}
  </article>

  <aside class="side-card" aria-label="Plan your visit">
    <h2>{{ {hotel: 'Plan your stay', golf: 'Plan your round', restaurant: 'Plan your visit'}[kind] }}</h2>
    <dl>
      <div><dt>Area</dt><dd>{{ v.neighborhood }}</dd></div>
      {% if v.category %}<div><dt>Style</dt><dd>{{ v.category }}</dd></div>{% endif %}
      <div><dt>Source checked</dt><dd><time datetime="{{ v.last_checked }}">{{ v.last_checked }}</time></dd></div>
    </dl>
    {% if v.official_url %}<a class="btn btn-orange" href="{{ v.official_url | escape }}" rel="noopener" target="_blank">{{ officialLabel }} {{ icon('external') }}<span class="sr-only"> (opens in a new tab)</span></a>
    {% elif v.source_url %}<a class="btn btn-orange" href="{{ v.source_url | escape }}" rel="noopener" target="_blank">Official information {{ icon('external') }}</a>{% endif %}
    <p class="small">No live prices or availability. Confirm the details for your dates directly.</p>
    <div class="side-links">
      <a href="{{ listHref }}">All {{ listLabel | lower }} {{ icon('arrow-right') }}</a>
      {% if kind != 'hotel' %}<a href="/hotels/?area={{ v | hotelAreaFor | encodeUri }}">Places to stay nearby {{ icon('arrow-right') }}</a>{% endif %}
      {% if kind != 'restaurant' %}<a href="/restaurants/">Where to eat {{ icon('arrow-right') }}</a>{% endif %}
      <a href="/things-to-do/">Things to do {{ icon('arrow-right') }}</a>
    </div>
  </aside>
</div>

{% if related and related.length %}
<section class="section section-sand" aria-labelledby="related-title">
  <div class="container">
    <div class="section-head"><div><p class="eyebrow">Keep exploring</p><h2 id="related-title">{{ {hotel: 'More stays to compare', golf: 'More golf clubs', restaurant: 'More places to eat'}[kind] }}</h2></div></div>
    <div class="card-grid cols-3">
      {% for o in related %}{% set ph = o.data | cardPhoto(editorialPhotos) %}
      {{ card(listHref + (o.data.slug or (o.data.title | slugify)) + '/', ph, o.data.title, o.data.excerpt | shorten(110), o.data.neighborhood, '', '', '(max-width: 700px) 92vw, 32vw') }}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
