{% set galleryPhotos = galleryItem | photoGallery(editorialPhotos) %}
{% if galleryPhotos.length and (kind != 'restaurant' or (not galleryPhotos[0].contextual and not galleryItem.identity_unverified)) %}
<section class="editorial-gallery" aria-label="Photographs and credits">
  <h2>{% if galleryPhotos[0].contextual %}Around the area{% else %}Photos{% endif %}</h2>
  <p class="gallery-context">{% if galleryPhotos[0].contextual %}Credited photos of the surrounding area — not of this venue or event.{% else %}Dated archival photos of the property; facilities and branding may have changed.{% endif %} <a href="/photography/">Photo credits</a></p>
  <div class="editorial-photo-grid">{% for photo in galleryPhotos %}<figure class="editorial-photo"><img{% if photo.preserve_framing %} data-preserve-framing="true"{% endif %} src="{{ photo.src | opt(640) }}" alt="{{ photo.alt | escape }}" width="{{ photo.width or 1200 }}" height="{{ photo.height or 800 }}" loading="lazy" decoding="async"><figcaption><strong>{% if photo.contextual %}Area{% else %}Property archive{% endif %}</strong> · {{ photo.caption }}{% if photo.archive_warning %}<span class="photo-context-note">{{ photo.archive_warning }}</span>{% endif %}</figcaption></figure>{% endfor %}</div>
</section>
{% endif %}
