{% set galleryPhotos = galleryItem | photoGallery(editorialPhotos) %}
{% if galleryPhotos.length %}
<section class="editorial-gallery" aria-label="Photographs and credits">
  <h2>{% if galleryPhotos[0].contextual %}Around the area{% else %}Photos{% endif %}</h2>
  <p class="gallery-context">{% if galleryPhotos[0].contextual %}Credited photos of the surrounding area — not of this venue or event.{% else %}Dated archival photos of the property; facilities and branding may have changed.{% endif %}</p>
  <div class="editorial-photo-grid">{% for photo in galleryPhotos %}<figure class="editorial-photo"><a href="{{ photo.source_url | escape }}" target="_blank" rel="noopener"><img{% if photo.preserve_framing %} data-preserve-framing="true"{% endif %} src="{{ photo.src | opt(640) }}" alt="{{ photo.alt | escape }}" width="{{ photo.width or 1200 }}" height="{{ photo.height or 800 }}" loading="lazy" decoding="async"></a><figcaption><strong>{% if photo.contextual %}Area{% else %}Property archive{% endif %}</strong> · {{ photo.caption }}{% if photo.archive_warning %}<span class="photo-context-note">{{ photo.archive_warning }}</span>{% endif %}<span class="photo-credit">Photo: {{ photo.author }} · {% if photo.license_url %}<a href="{{ photo.license_url | escape }}">{{ photo.license }}</a>{% else %}{{ photo.license }}{% endif %} · <a href="{{ photo.source_url | escape }}">Source</a>{% if photo.changes %} · {{ photo.changes }}{% endif %}</span></figcaption></figure>{% endfor %}</div>
</section>
{% endif %}
