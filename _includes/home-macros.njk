{# Original, decorative line icons. Text labels remain the accessible name. #}
{% macro icon(name) -%}
<svg class="home-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{% if name == 'sun' %}<circle cx="12" cy="9" r="3.5"/><path d="M12 1v2m0 12v2M4 9H2m20 0h-2M5 2l1.5 1.5M19 2l-1.5 1.5M3 21c2-2 4 2 6 0s4 2 6 0 4 2 6 0"/>
{% elif name == 'bed' %}<path d="M3 18V7m18 11V9H8v7M3 16h18M3 20v-2m18 2v-2"/><path d="M3 10h3v4H3"/>
{% elif name == 'food' %}<path d="M5 3v6c0 3 4 3 4 0V3M7 3v18m12 0V3c-4 3-5 9 0 9"/>
{% elif name == 'calendar' %}<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 11h18m-14 4h3m4 0h3m-10 3h3"/>
{% elif name == 'golf' %}<path d="M8 20V3l10 4-10 4M4 20c0-2 8-2 8 0s-8 2-8 0"/><circle cx="19" cy="18" r="1.5"/>
{% elif name == 'compass' %}<circle cx="12" cy="12" r="9"/><path d="m16 8-2.5 5.5L8 16l2.5-5.5Z"/>
{% elif name == 'columns' %}<path d="m3 7 9-4 9 4M3 8h18M5 10v8m5-8v8m4-8v8m5-8v8M3 21h18M4 18h16"/>
{% elif name == 'leaf' %}<path d="M20 3C4 2 1 16 8 19c8 4 14-5 12-16ZM5 22 17 7"/>
{% elif name == 'map' %}<path d="m3 5 6-2 6 2 6-2v16l-6 2-6-2-6 2Zm6-2v16m6-14v16"/>
{% elif name == 'plane' %}<path d="m21 3-8 18-3-7-7-3Zm0 0L10 14"/>
{% elif name == 'arrow' %}<path d="M5 12h14m-5-5 5 5-5 5"/>
{% elif name == 'search' %}<circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/>
{% elif name == 'pin' %}<path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2"/>
{% endif %}
</svg>
{%- endmacro %}

{% macro image(photo, sizes, eager=false, wide=false) -%}
<img src="/images/home/{{ photo.id }}-960.webp" srcset="/images/home/{{ photo.id }}-480.webp 480w, /images/home/{{ photo.id }}-960.webp 960w{% if eager or wide %}, /images/home/{{ photo.id }}-1920.webp 1920w{% endif %}" sizes="{{ sizes }}" alt="{{ photo.alt }}" width="{{ photo.width }}" height="{{ photo.height }}" {% if eager %}fetchpriority="high" loading="eager"{% else %}loading="lazy"{% endif %} decoding="async">
{%- endmacro %}

{% macro credit(photo) -%}
<details class="home-credit"><summary><span aria-hidden="true">©</span><span class="sr-only">Photo credit: {{ photo.caption }}</span></summary><div><strong>{{ photo.caption }}</strong><span>{{ photo.author }} · <a href="{{ photo.license_url }}">{{ photo.license }}</a> · <a href="{{ photo.source_url }}">Source</a></span><span>Resized to WebP; cropped for display.</span></div></details>
{%- endmacro %}
