{# Responsive image. Uses optimized WebP when present. #}
{% macro pic(src, alt, sizes='(max-width: 700px) 100vw, 33vw', eager=false, width=1280, height=853, cls='') -%}
{%- set set = src | srcset -%}
<img{% if cls %} class="{{ cls }}"{% endif %} src="{{ src | opt(1280 if eager else 640) }}"{% if set %} srcset="{{ set }}" sizes="{{ sizes }}"{% endif %} alt="{{ alt | escape }}" width="{{ width or 1280 }}" height="{{ height or 853 }}" {% if eager %}fetchpriority="high" loading="eager"{% else %}loading="lazy"{% endif %} decoding="async">
{%- endmacro %}

{# Licence credit for Creative Commons photographs. #}
{% macro credit(photo) -%}
{%- if photo and photo.author -%}
<details class="credit"><summary><span aria-hidden="true">©</span><span class="sr-only">Photo credit: {{ photo.caption }}</span></summary><div><strong>{{ photo.caption }}</strong><span>{{ photo.author }} · <a href="{{ photo.license_url or photo.licenseUrl }}" rel="noopener">{{ photo.license }}</a> · <a href="{{ photo.source_url or photo.sourceUrl }}" rel="noopener">Source</a></span></div></details>
{%- endif -%}
{%- endmacro %}

{# Miami-style editorial card: photo, serif title with arrow, short text. #}
{% macro card(href, photo, title, text='', eyebrow='', badge='', meta='', sizes='(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 24vw', attrs='') -%}
<article class="card"{{ attrs | safe }}>
  <div class="card-media">
    <a href="{{ href }}" tabindex="-1" aria-hidden="true">{% if photo %}{{ pic(photo.src, photo.alt or title, sizes, false, photo.width, photo.height) }}{% else %}<span class="card-blank"></span>{% endif %}</a>
    {% if badge %}<span class="card-badge">{{ badge }}</span>{% endif %}
    {% if photo and photo.contextual and photo.areaLabel %}<span class="card-area">{{ icon('camera') }} Area photo · {{ photo.areaLabel }}</span>{% endif %}
    {{ credit(photo) }}
  </div>
  {% if eyebrow %}<p class="card-eyebrow">{{ eyebrow }}</p>{% endif %}
  <h3 class="card-title"><a href="{{ href }}">{{ title }}</a>{{ icon('arrow-up-right', 'card-arrow') }}</h3>
  {% if meta %}<p class="card-meta">{{ meta | safe }}</p>{% endif %}
  {% if text %}<p class="card-text">{{ text }}</p>{% endif %}
</article>
{%- endmacro %}

{# Horizontal list card (Miami hotel directory). #}
{% macro rowCard(href, photo, title, text='', chips=[], badge='', attrs='', side='') -%}
<article class="row-card"{{ attrs | safe }}>
  <div class="row-card-media">
    <a href="{{ href }}" tabindex="-1" aria-hidden="true">{% if photo %}{{ pic(photo.src, photo.alt or title, '(max-width: 700px) 92vw, 280px', false, photo.width, photo.height) }}{% else %}<span class="card-blank"></span>{% endif %}</a>
    {% if badge %}<span class="card-badge">{{ badge }}</span>{% endif %}
    {% if photo and photo.contextual %}<span class="card-area card-area-sm">Area photo</span>{% endif %}
    {{ credit(photo) }}
  </div>
  <div class="row-card-body" data-search-text>
    <h3 class="card-title"><a href="{{ href }}">{{ title }}</a>{{ icon('arrow-up-right', 'card-arrow') }}</h3>
    {% if text %}<p class="card-text clamp-2">{{ text }}</p>{% endif %}
    {% if chips.length %}<ul class="chips">{% for c in chips %}{% if c.label %}<li>{{ icon(c.icon) }}<span>{{ c.label }}</span></li>{% endif %}{% endfor %}</ul>{% endif %}
  </div>
  {% if side %}<div class="row-card-side">{{ side | safe }}</div>{% endif %}
</article>
{%- endmacro %}

{% macro sectionHead(eyebrow, title, href='', linkText='', id='', sub='') -%}
<div class="section-head">
  <div>
    {% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
    <h2{% if id %} id="{{ id }}"{% endif %}>{{ title }}</h2>
    {% if sub %}<p class="subhead">{{ sub }}</p>{% endif %}
  </div>
  {% if href %}<a class="btn btn-sm" href="{{ href }}">{{ linkText }}</a>{% endif %}
</div>
{%- endmacro %}

{% macro wave(fill='var(--bg)', cls='') -%}
<svg class="wave {{ cls }}" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path fill="{{ fill }}" d="M0 64c160-46 320-62 520-34s340 74 560 66 260-50 360-70v94H0Z"/></svg>
{%- endmacro %}

{# Full-bleed photo hero with a wave, then the page title below it. #}
{% macro pageHero(photo, eyebrow, title, lead='', crumbs=[]) -%}
<section class="page-hero">
  <div class="page-hero-media">
    {% if photo %}{{ pic(photo.src, photo.alt or title, '100vw', true, photo.width, photo.height) }}{{ credit(photo) }}{% endif %}
    {{ wave('var(--bg)') }}
  </div>
  <div class="container page-hero-copy">
    {% if crumbs.length %}<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a>{% for c in crumbs %} <span aria-hidden="true">/</span> {% if c.href %}<a href="{{ c.href }}">{{ c.label }}</a>{% else %}<span aria-current="page">{{ c.label }}</span>{% endif %}{% endfor %}</nav>{% endif %}
    {% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
    <h1>{{ title | safe }}</h1>
    {% if lead %}<p class="subhead">{{ lead }}</p>{% endif %}
  </div>
</section>
{%- endmacro %}

{# Blue band with a white rounded card whose text collapses behind "Read more". #}
{% macro introCard(id='intro') -%}
<section class="intro-band">
  <div class="container">
    <div class="intro-card" data-readmore>
      <div class="intro-text" id="{{ id }}-text">{{ caller() }}</div>
      <button type="button" class="readmore-btn" aria-expanded="false" aria-controls="{{ id }}-text" hidden>Read more</button>
    </div>
  </div>
</section>
{%- endmacro %}
