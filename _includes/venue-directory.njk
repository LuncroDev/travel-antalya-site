<div data-venue-directory>
<form class="filter-panel" data-venue-filters hidden aria-label="Filter {{ venuePlural }}"><div class="filter-grid"><label>Search<input type="search" name="q" placeholder="Name, area or keyword" autocomplete="off"></label><label>Area<select name="area"><option value="">All areas</option>{% for area in venueItems | uniqueValues('neighborhood') %}<option value="{{ area | escape }}">{{ area }}</option>{% endfor %}</select></label><label>Style<select name="category"><option value="">All styles</option>{% for category in venueItems | uniqueValues('category') %}<option value="{{ category | escape }}">{{ category }}</option>{% endfor %}</select></label><button type="reset" class="btn btn-outline">Reset</button></div></form>
<p data-venue-count role="status" aria-live="polite">{{ venueItems.length }} {{ venuePlural }}</p><noscript><p>All profiles are listed below. Use your browser’s Find command to locate a name or place.</p></noscript><div class="venue-grid">
{% for v in venueItems %}<article class="venue-card" data-venue data-area="{{ v.data.neighborhood | escape }}" data-category="{{ v.data.category | escape }}"><span class="eyebrow">{{ v.data.neighborhood }}</span><h2><a href="/{{ venuePath }}/{{ v.data.slug or (v.data.title | slugify) }}/">{{ v.data.title }}</a></h2><span class="badge">{{ v.data.category }}</span><p>{{ v.data.excerpt }}</p>{% if v.data.status_note %}<p class="notice">{{ v.data.status_note }}</p>{% endif %}<p class="venue-source">Source reviewed {{ v.data.last_checked }}</p><a class="text-link" href="/{{ venuePath }}/{{ v.data.slug or (v.data.title | slugify) }}/">Explore the profile ↗</a></article>{% endfor %}</div><div data-venue-empty class="empty-state" hidden><h2>No matching {{ venuePlural }}</h2><p>Try another name or area, or reset your filters.</p><button type="button" data-venue-reset class="btn btn-blue">Show all</button></div></div><script src="/js/venues.js" defer></script>
