{% from 'ui.njk' import icon, rowCard %}
<div data-venue-directory>
<form class="toolbar" data-venue-filters hidden aria-label="Filter {{ venuePlural }}">
  <div class="search-pill">{{ icon('search') }}<label class="sr-only" for="venue-q">Search {{ venuePlural }}</label><input id="venue-q" type="search" name="q" placeholder="Name, area or cuisine" autocomplete="off"></div>
  <div class="filter-row">
    <label for="venue-area">Area</label>
    <select id="venue-area" name="area" class="select-pill"><option value="">All areas</option>{% for area in venueItems | uniqueValues('neighborhood') %}<option value="{{ area | escape }}">{{ area }}</option>{% endfor %}</select>
    <label for="venue-cat">Style</label>
    <select id="venue-cat" name="category" class="select-pill"><option value="">All styles</option>{% for category in venueItems | uniqueValues('category') %}<option value="{{ category | escape }}">{{ category }}</option>{% endfor %}</select>
    <button type="reset" class="btn btn-sm btn-outline">Reset filters</button>
  </div>
</form>
<p data-venue-count role="status" aria-live="polite">{{ venueItems.length }} {{ venuePlural }}</p>
<noscript><p>All profiles are listed below. Use your browser’s Find command to locate a name or place.</p></noscript>
<div class="row-list">
{% for v in venueItems %}
{% set ph = v.data | cardPhoto(editorialPhotos) %}
{% set attrs = ' data-venue data-area="' + (v.data.neighborhood | escape) + '" data-category="' + (v.data.category | escape) + '"' %}
{{ rowCard('/' + venuePath + '/' + (v.data.slug or (v.data.title | slugify)) + '/', ph, v.data.title, v.data.excerpt, [{icon: 'pin', label: v.data.neighborhood}, {icon: venueIcon or 'food', label: v.data.category}], '', attrs, ('<p class="notice" style="margin:0;max-width:260px;font-size:.95rem"><strong>Notice:</strong> ' + (v.data.status_note | escape) + '</p>') if v.data.status_note else '') }}
{% endfor %}
</div>
<div data-venue-empty class="empty-state" hidden><h2>No matching {{ venuePlural }}</h2><p>Try another name or area, or reset your filters.</p><button type="button" data-venue-reset class="btn btn-orange">Show all</button></div>
</div>
<script src="/js/venues.js" defer></script>
